# Local demo only. Never reuse these credentials in a real deployment.
POSTGRES_PASSWORD=local-demo-owner
RUNTIME_PASSWORD=local-demo-runtime
MIGRATOR_PASSWORD=local-demo-migrator
DEMO_PASSWORD=Demo-EczaNet-2026!
DEMO_DATE=2026-10-24
DEMO_SEED=33906
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
HTTP_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
DB_POOL_MAX=10
SIMULATOR_ENABLED=false

# A2 transaction budget: lock <= statement <= HTTP; nginx waits 20s.
STOCK_LOCK_TIMEOUT=2s
STOCK_STATEMENT_TIMEOUT=5s

# Full deterministic A6 history; opt-in keeps existing small installations safe.
DEMO_FULL_SEED=true
SIMULATOR_SPEED=1
