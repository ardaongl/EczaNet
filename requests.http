Origin: {{origin}}
Content-Type: application/json
X-CSRF-Token: {{warehouseLogin.response.body.$.csrf_token}}
Idempotency-Key: {{run}}-transfer

{"location_id":"21","target_id":"1","items":[{"product_id":"{{product.response.body.$.id}}","quantity":"6","unit":"unit"}]}

